{
  // Type-checking configuration, read by both the pyright CLI and Pylance in VSCode.

  // Without these, neither tool finds pytest -- it lives in the project-local venv, not
  // in the system Python -- and every test file reports an unresolved import.
  "venvPath": ".",
  "venv": ".venv",

  // Mirrors pythonpath in pytest.ini: the fuzz_lab package is imported from the repository
  // root and the shared ASan report builders from tests/, so both directories have to be
  // importable for the checker the same way they are at runtime.
  "extraPaths": [".", "tests"],

  // *_fuzz/ directories hold vendored C sources and git checkouts created by the tool
  // itself; .venv holds third-party packages. Neither is code this project type-checks.
  "exclude": [".venv", "**/*_fuzz", "**/__pycache__"],

  "typeCheckingMode": "standard"
}
