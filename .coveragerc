[run]
# Measure the fuzz_lab package, which is all of the project's Python. Naming the package
# rather than "." is what keeps the percentage honest: the test suite, the virtualenv and
# the generated <name>_fuzz/ working directories are simply outside it, so none of them
# need an omit entry to stay out of the number.
source = fuzz_lab

[report]
# Show which lines are missing rather than only a total, and skip files that are fully
# covered so the report stays focused on what still needs tests.
show_missing = True
skip_covered = True

exclude_also =
    # The script entry point only runs when the module is executed directly, never under
    # pytest. Covering it would mean a test that exists purely to touch one line.
    if __name__ == .__main__.:
